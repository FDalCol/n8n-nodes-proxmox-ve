{
	"name": "n8n-nodes-proxmox-ve",
	"version": "0.2.1",
	"description": "n8n community nodes for Proxmox VE: nodes, VMs, containers, guest agent, storage, backups, cluster, HA, tasks and a polling trigger.",
	"license": "MIT",
	"homepage": "https://github.com/FDalCol/n8n-nodes-proxmox-ve#readme",
	"bugs": {
		"url": "https://github.com/FDalCol/n8n-nodes-proxmox-ve/issues"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://buymeacoffee.com/FDalCol"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"proxmox",
		"proxmox-ve",
		"pve",
		"virtualization",
		"qemu",
		"lxc"
	],
	"author": {
		"name": "FDalCol",
		"email": "353270041+FDalCol@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FDalCol/n8n-nodes-proxmox-ve.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build && npm run lint && npm test"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"index.js"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ProxmoxVeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ProxmoxVe/ProxmoxVe.node.js",
			"dist/nodes/ProxmoxVeTrigger/ProxmoxVeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/backend-network": "1.20.6",
		"@n8n/node-cli": "0.55.6",
		"@types/node": "26.6.6",
		"eslint": "9.39.4",
		"n8n-workflow": "2.45.0",
		"prettier": "3.8.3",
		"selfsigned": "5.5.0",
		"typescript": "5.9.3",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
